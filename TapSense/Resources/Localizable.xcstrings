    "privacy.catalog_body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If your exact phone model isn't already bundled with the app, it may look it up against a remote catalog of known antenna locations. That request includes only your device's manufacturer and model name - nothing else identifying you or your device."
          }
        }
      }
    },
    "privacy.catalog_title" : {
