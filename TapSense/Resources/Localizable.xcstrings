    "privacy.permissions_body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TapSense requests NFC access only to read tags during a tap test. It does not request location, contacts, camera, microphone, or storage access."
