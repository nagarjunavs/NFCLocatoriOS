    "privacy.disclaimer" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This page explains what data TapSense collects, why, and how it's handled."
          }
        }
      }
    },
    "privacy.on_device_body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finding your phone's antenna location happens entirely on-device, using iOS's own Core NFC APIs. Nothing about when or where you tap is recorded or sent anywhere."
          }
        }
      }
    },
    "privacy.on_device_title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
