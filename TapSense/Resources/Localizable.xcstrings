        }
      }
    },
    "education.faq_pay_vs_scan" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap-to-pay vs. tag scanning"
          }
        }
      }
    },
    "education.faq_pay_vs_scan_answer" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap-to-pay talks to a secure payment terminal; tag scanning reads a small passive chip. Both use the same antenna and tap zone."
          }
        }
      }
    },
    "education.faq_tap_tag" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How do I tap an NFC tag?"
          }
        }
      }
    },
    "education.faq_tap_tag_answer" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold your phone's tap zone directly against the tag and keep it steady for a second or two."
          }
        }
      }
    },
    "education.faq_why_fail" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why a tap can fail"
          }
        }
      }
    },
    "education.faq_why_fail_answer" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thick cases, magnetic accessories, low battery, or simply missing the tap zone are the most common causes."
          }
        }
      }
    },
    "education.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NFC basics"
          }
        }
      }
    },
    "education.what_is_nfc_body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NFC works only at very close range — a few centimeters. Placing your phone's tap area directly against the device and holding it still gives the most reliable read."
          }
        }
      }
    },
    "education.what_is_nfc_title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
