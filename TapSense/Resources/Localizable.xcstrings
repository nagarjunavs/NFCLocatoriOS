    "education.faq_antenna_location" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where is the antenna on my phone?"
          }
        }
      }
    },
    "education.faq_antenna_location_answer" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usually near the upper back, close to the main camera — TapSense shows the exact spot for your model on the My Phone screen."
          }
        }
      }
    },
    "education.faq_collapsed" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
